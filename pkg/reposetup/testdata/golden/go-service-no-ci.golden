      - 'release#v*.*.*'
      - 'release#major'
      - 'release#minor'
      - 'release#patch'
      - 'release#major-rc'
      - 'release#minor-rc'
      - 'release#patch-rc'
      - 'release#rc'
      - 'release#rc-release'
      - 'release-v*.*.x#release#v*.*.*'
      # "!" negates previous positive patterns so it has to be at the end.
