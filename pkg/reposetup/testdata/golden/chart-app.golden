template: giantswarm/template-app
command: devctl gen makefile --flavour app --language generic
command: devctl gen workflows --flavour app --language generic --install-update-chart --release-workflow auto-release
command: devctl gen llm --flavour app --language generic
command: devctl gen precommit --language generic --repo-name example --flavors helmchart
command: devctl gen circleci --repo-name example --language generic --flavour app
command: devctl gen renovate --language generic --circleci-generated --repo-name example

--- .abs/main.yaml
replace-chart-version-with-git: true
generate-metadata: true
chart-dir: ./helm/example
destination: ./build

--- .circleci/config.yml
# DO NOT EDIT. This file is generated by `devctl gen circleci` and kept in sync
# by the giantswarm/github align-files workflow. Change the generator in devctl
# (pkg/gen/input/circleci) or the gen.ci config in giantswarm/github, not here.
#
# This is a dynamic-config setup workflow. It deep-merges the optional
# repo-owned .circleci/custom.yml into the generated .circleci/workflows.yml
# and continues the pipeline with the result. Repo-specific jobs and workflows
# (e2e, crons, mirrors, ...) belong in .circleci/custom.yml -- it takes effect
# on the PR that adds or edits it, and devctl never touches it.
version: 2.1
setup: true
orbs:
  continuation: circleci/continuation@2.0.1

jobs:
  setup:
    executor: continuation/default
    resource_class: small
    steps:
    - checkout
    - run:
        name: Merge optional custom.yml into generated workflows.yml
        # yq `*+` deep-merge: maps merge, lists append -- custom workflow
        # entries are appended to the generated job lists. A malformed
        # custom.yml fails here, on the PR that introduced it.
        command: |
          if [ -f .circleci/custom.yml ]; then
            yq eval-all '. as $item ireduce ({}; . *+ $item)' \
              .circleci/workflows.yml .circleci/custom.yml > .circleci/continue.yml
          else
            cp .circleci/workflows.yml .circleci/continue.yml
          fi
    - continuation/continue:
        configuration_path: .circleci/continue.yml

workflows:
  setup:
    jobs:
    - setup:
        filters:
          tags:
            only: /^v.*/

--- .circleci/workflows.yml
# DO NOT EDIT. This file is generated by `devctl gen circleci` and kept in sync
# by the giantswarm/github align-files workflow. Change the generator in devctl
# (pkg/gen/input/circleci) or the gen.ci config in giantswarm/github, not here.
# Repo-specific jobs and workflows go in .circleci/custom.yml, which the setup
# workflow in .circleci/config.yml merges into this file at pipeline runtime.
version: 2.1
orbs:
  architect: giantswarm/architect@10.5.0

workflows:
  build:
    jobs:

    # build-chart: package + lint via app-build-suite and persist the archive
    # (no push). Shared by the branch and tag paths -- branches get build + test
    # only by default.
    - architect/push-to-app-catalog:
        executor: app-build-suite
        context: architect
        name: build-chart
        app_catalog: giantswarm-catalog
        app_catalog_test: giantswarm-test-catalog
        chart: example
        # `appVersion` is the version of the packaged application, and this chart
        # packages an app built elsewhere, so that app's version is what
        # Chart.yaml declares. Keep it; the chart version is still stamped.
        override_app_version: false
        push_to_appcatalog: false
        push_to_oci_registry: false
        persist_chart_archive: true
        filters:
          tags:
            only: /^v.*/
          branches:
            ignore:
            - main

    # Branch: run chart tests after build-chart. When branchPublish pushes a dev
    # image, the test also waits on push-to-registries -- run-tests-with-ats
    # deploys the chart, which pulls that image from gsoci, and gating on the
    # push avoids an ImagePullBackOff race. The architect context carries the
    # registry credentials the job hands to its kind node, so the chart can pull
    # private images (gsociprivate) without imagePullSecrets. The kind cluster
    # the job creates takes its configuration (feature gates, runtime config,
    # patches, extra nodes) from .ats/kind-config.yaml when the repo carries one
    # -- repo-owned, like .ats/main.yaml -- and its resource class from
    # gen.ci.atsResourceClass in giantswarm/github (the orb default is medium).
    - architect/run-tests-with-ats:
        name: execute-chart-tests
        context: architect
        app-test-suite_container_tag: "1.0.3"
        # app-test-suite 1.x provisions no cluster: the job creates the kind
        # cluster and runs the pinned image against its kubeconfig.
        create_kind_cluster: true
        requires:
        - build-chart
        filters:
          branches:
            ignore:
            - main

    # Tag: push the chart after build-chart (+ the gsoci image). The chart
    # tests ran on the branch (execute-chart-tests) and the tag is cut from the
    # merge commit of a PR whose branch run tested this tree, so they are not
    # re-run here (atsOnRelease brings the tag-time run back). Make the
    # ci/circleci statuses required checks on the default branch, with
    # up-to-date branches (strict), so a PR cannot merge before that run is
    # green. Intentionally does NOT depend on sync-china-registry so the chart
    # catalog can publish even if the in-China Aliyun mirror is slow or fails.
    - architect/push-to-app-catalog:
        executor: app-build-suite
        context: architect
        name: push-chart-release
        app_catalog: giantswarm-catalog
        app_catalog_test: giantswarm-test-catalog
        chart: example
        # `appVersion` is the version of the packaged application, and this chart
        # packages an app built elsewhere, so that app's version is what
        # Chart.yaml declares. Keep it; the chart version is still stamped.
        override_app_version: false
        requires:
        - build-chart
        filters:
          tags:
            only: /^v.*/
          branches:
            ignore: /.*/

--- .cursor/rules/zz_generated.base-llm-rules.mdc
---
description: Instructions for AI/LLM assistants
alwaysApply: true
---

# Instructions for AI/LLM assistants

You are an AI assistant acting as an expert software developer and platform engineer working on Giant Swarm platform components. Your task is to act as a pair programmer and help others working in this codebase to keep the code delightful to work with. This includes ensuring that the code adheres to Giant Swarm's quality standards, keeping the project well-architected and organized, and maintaining supporting documentation, diagrams, and rules for other AI assistants.

# Persona: Senior Giant Swarm Platform Engineer

- **Technical Depth**: You are a domain expert in Go (formerly, golang), Helm, Kubernetes APIs and development, software design patterns, software architecture, Go application security, software testing, and software performance optimization,
- **Problem-Solver**: You approach issues methodically, prioritizing safety and stability. You first investigate deeply with the tools provided to you, before suggesting changes. You find and fix the root cause, not the symptoms.
- **Clear Communicator**: You explain complex topics clearly and provide actionable steps.
- **Collaborative**: You guide users, suggest diagnostic paths, and help them think through problems.
- **Best Practices**: You adhere to Giant Swarm operational and technical standards.

# Reviewer Guidelines

## Core Behaviors

- Unless directed by the user, never use or recommend external linters, code analysis, or other tooling which isn't already recommended in Giant Swarm agent rules or style guides.
- Always adhere to the central coding guidelines and best practices maintained at: @https://github.com/giantswarm/fmt/
- Prioritize readability, maintainability, and security.
- Write comprehensive tests and documentation.
- If documentation is available in the `docs` folder, keep this up-to-date when changing code.
- Maintain the main README.md file for correctness.
- If a changelog is available as CHANGELOG.md, add your changes to it.

## Release Management

- Follow the changelog and release guidelines from @https://github.com/giantswarm/fmt/tree/main/releases
- Use semantic versioning and conventional commits


## Language-Specific Guidelines

Additional language-specific rules can be found in the general style guide and in the other rules files in this repository.



---

For detailed guidelines and examples, always refer to: @https://github.com/giantswarm/fmt/


