--- cliff.toml
# DO NOT EDIT. Generated with:
#
#    devctl
#
#    https://github.com/giantswarm/devctl/blob/<commit>/pkg/gen/input/workflows/internal/file/cliff.toml.template
#
# git-cliff config for the push-based auto-release flow.
#
# A single git-cliff invocation in .github/workflows/auto-release.yaml runs
# `--unreleased --bump --context` to compute the next semver from conventional
# commits AND emit the JSON context that the same workflow then re-renders
# with `--from-context --strip all` for the release-notes body posted on the
# GitHub Release. One commit walk, one set of GitHub API PR lookups, two
# cheap outputs.

[bump]
# `feat:` always bumps minor (not patch). Matches conventional-commits spec.
features_always_bump_minor = true
# `feat!:`/`BREAKING CHANGE` always bumps major.
breaking_always_bump_major = true
# First release in a repo with no tags yet. git-cliff defaults this to
# "0.1.0" (no prefix); we pin it to "v0.1.0" because the whole giantswarm
# stack (architect's /^v.*/ tag filter, the auto-release workflow's
# `--match='v*.*.*'` describe, gitsemver) expects the leading `v`. Once any
# v*.*.* tag exists, git-cliff carries that prefix forward on every bump, so
# this only governs the inception release.
initial_tag = "v0.1.0"

[git]
conventional_commits = true
# Drop non-conventional commits silently rather than counting them as
# unclassified work -- the bump-decider should only act on intent-bearing
# commits.
filter_unconventional = true
# Changelog presentation order. `topo_order = false` orders releases
# chronologically (by tag date); `sort_commits = "oldest"` lists the commits
# within each release oldest-first.
topo_order = false
sort_commits = "oldest"

# Scope `--bump`'s baseline to the current branch. This is load-bearing for
# two reasons:
#
#   1. Backports. The auto-release workflow also fires on `release-*`
#      maintenance branches. Without this, git-cliff's `--bump` picks the
#      GLOBALLY highest-semver tag in the repo regardless of reachability --
#      so a fix on `release-2.x` would bump from v3.1.0 (latest on main) and
#      tag v3.1.1 ON the 2.x line instead of the intended v2.8.1. With
#      `use_branch_tags`, git-cliff only considers tags reachable from the
#      checked-out branch, so the 2.x line correctly bumps from v2.8.0.
#
#   2. Stray tags on side branches. A tag created on an unmerged branch
#      (e.g. someone tags v9.0.0 while testing a release on a `bump/*`
#      branch) is the global semver max but is NOT reachable from main.
#      Without this it silently becomes the baseline for every subsequent
#      main release, and a `feat:` on a v1.2.8 line produces v9.1.0.
#      Branch-scoped tags exclude it.
use_branch_tags = true

# Only vX.Y.Z is a release. git-cliff applies this before everything else, so
# a tag that does not match is not a boundary for `--unreleased`, not a
# baseline for `--bump` and not a release in the changelog. That is what keeps
# a candidate cycle one range: the auto-release flow cuts vX.Y.Z-rc.N tags on
# the branch head, and counting those as releases would cut every later
# candidate, and the stable release that closes the cycle, from a partial
# delta -- a cycle a `feat-rc` put on a minor falls back to a patch. The price
# is that candidate notes are cumulative: rc.2 lists what rc.1 listed, plus
# what is new.
#
# It also keeps a pre-release or preview tag off the version line wherever it
# lives, which `use_branch_tags` alone only does on a SIDE branch: such a name
# always carries a suffix, so it can never match. The workflow's
# `git describe --match='v*.*.*' --exclude='*-*' --exclude='*+*'` baseline
# selects the same tags, and the two have to stay in step.
tag_pattern = '^v[0-9]+\.[0-9]+\.[0-9]+$'

# Strip the trailing " (#N)" that GitHub appends to squash-merge commit
# messages. Our template renders the PR link explicitly via cliff's GitHub
# integration (commit.remote.pr_number -- see [changelog].body), so the
# auto-appended reference would duplicate it.
#
# `(?m)` enables multi-line mode so `$` matches end-of-line (the squash
# `(#N)` lives at the end of the subject line, not the end of the full
# commit text -- git-cliff's default regex mode is single-line). This
# anchoring keeps `(#N)` references that appear inside commit bodies
# untouched.
#
# feat-rc/fix-rc mark a release candidate. The auto-release workflow reads the
# raw subjects to spot them; git-cliff must see the plain type, because
# `features_always_bump_minor` keys off the type being exactly "feat" and an
# un-normalised feat-rc would bump patch instead of minor.
commit_preprocessors = [
  { pattern = '(?m) \(#\d+\)$', replace = "" },
  { pattern = '^(feat|fix)-rc', replace = "${1}" },
]

# Map commit types to changelog groups (Keep-a-Changelog convention):
# feat -> Added, fix -> Fixed, all "internal change" types -> Changed,
# security -> Security.
#
# `docs` and `style` are marked skip. git-cliff decides the bump from the
# commits that are NOT skipped: a breaking change bumps the major, `feat` the
# minor, every other type at least the patch. A skipped commit is left out of
# the release notes and of the bump, so a docs-only or style-only push to main
# computes the current version and the workflow tags nothing; the change
# ships with the next release. `chore` and `ci` keep releasing: a
# `chore(deps)` bump changes what ships, a `ci` change how it is built.
commit_parsers = [
  { message = "^feat",     group = "Added" },
  { message = "^fix",      group = "Fixed" },
  { message = "^refactor", group = "Changed" },
  { message = "^perf",     group = "Changed" },
  { message = "^docs",     skip = true },
  { message = "^chore",    group = "Changed" },
  { message = "^test",     group = "Changed" },
  { message = "^build",    group = "Changed" },
  { message = "^ci",       group = "Changed" },
  { message = "^security", group = "Security" },
  { message = "^style",    skip = true },
]

# GitHub repo coordinates -- required for the API lookups that populate
# `commit.remote.pr_number` and `commit.remote.username` in the template
# below. The token is passed automatically via the workflow's GITHUB_TOKEN.
[remote.github]
owner = "giantswarm"
repo = ""

# Template for the rendered release notes. Body is what gets posted to the
# GitHub Release; header and footer are empty so the release page shows only
# the section list.
#
# Each bullet ends with " in [#N](pr-url) by [@user](user-url)" when
# git-cliff successfully resolves the PR for the commit via the GitHub API.
# `commit.remote` is the post-2.x replacement for the per-platform fields
# (commit.github / commit.gitlab / etc.) -- using it future-proofs the
# template against git-cliff dropping the old names.
# Backslashes at line ends escape the newline so the bullet stays on one
# line in the rendered Markdown.
[changelog]
header = ""
# `{%-` / `-%}` strip the surrounding newline so the rendered Markdown is
# tight: one blank line before each "### " header, no leading blank, no
# double-blank between header and bullets. Without the whitespace control
# the output picks up two extra blank lines per loop iteration.
body = """
{% for group, commits in commits | group_by(attribute="group") -%}
### {{ group }}

{% for commit in commits -%}
- {% if commit.scope %}*({{ commit.scope }})* {% endif %}\
{% if commit.breaking %}[**breaking**] {% endif %}\
{{ commit.message | split(pat="\n") | first | upper_first }}\
{% if commit.remote.pr_number %} in [#{{ commit.remote.pr_number }}](https://github.com/{{ remote.github.owner }}/{{ remote.github.repo }}/pull/{{ commit.remote.pr_number }}){% endif %}\
{% if commit.remote.username %} by [@{{ commit.remote.username }}](https://github.com/{{ commit.remote.username }}){% endif %}
{% endfor %}
{% endfor -%}
{% if previous.version %}
**Full Changelog**: https://github.com/{{ remote.github.owner }}/{{ remote.github.repo }}/compare/{{ previous.version }}...{{ version }}
{% endif -%}
"""
trim = true
footer = ""

--- helm/example/.schema.yaml
# .schema.yaml
# yaml-language-server: $schema=https://github.com/losisin/helm-values-schema-json/raw/refs/heads/main/config.schema.json

# DO NOT EDIT. Generated with:
#
#    devctl
#
#    https://github.com/giantswarm/devctl/blob/<commit>/pkg/gen/input/precommit/internal/file/schema.yaml.template
#

# The generated app-platform file goes first so keys the chart defines itself
# in values.yaml keep their own schema on merge.
values:
  - helm/example/zz_generated.app-platform.values.yaml
  - helm/example/values.yaml

draft: 2020
indent: 4
output: helm/example/values.schema.json

# We enable bundling as the Kubernetes schema is large, and helm only permits 15 seconds to fetch them.
# We have seen cases where helm timed out before fully fetching the schema.
# https://github.com/giantswarm/giantswarm/issues/36234
bundle: true
bundleRoot: ""
bundleWithoutID: true

k8sSchemaURL:
  https://raw.githubusercontent.com/yannh/kubernetes-json-schema/refs/heads/master/v1.33.1/
k8sSchemaVersion: "v1.33.1"

useHelmDocs: true

noAdditionalProperties: true
noDefaultGlobal: false

schemaRoot:
  additionalProperties: false

--- helm/example/Chart.yaml
# See https://docs.giantswarm.io/reference/platform-api/chart-metadata/
# for details and background.

apiVersion: v2

# Version of the packaged app
appVersion: 0.0.1

# Make sure your name DOES NOT end in "app" or "-app".
name: example

# Please describe what the app provides in a sentence or two.
description: Please add description

# URL of the GitHub repository that is the source of this Chart.yaml file.
home: https://github.com/giantswarm/example

# Default Giant Swarm icon, so that the first build passes the icon checks.
# Replace it with the app's own icon: add it to https://github.com/giantswarm/web-assets
# and set the final URL here.
icon: https://s.giantswarm.io/app-icons/giantswarm/1/light.svg

sources:
- https://github.com/some-org/some-repo
version: 0.0.0-dev
annotations:
  # Adapt to 'giantswarm' if this application is not to be deployed by customers
  io.giantswarm.application.audience: all
  # Adapt to 'true' if Giant Swarm takes responsibility for this app where it's deplyed
  io.giantswarm.application.managed: "false"
  # Team owning this app, used through .Chart.Annotations in templates/_helpers.tpl.
  # shield is a placeholder for the team's short name, e.g. 'shield' for team-shield.
  io.giantswarm.application.team: "shield"
  # Metadata for artifacthub.io, where Giant Swarm publishes all public charts
  # (see https://github.com/giantswarm/roadmap/issues/3940)
  artifacthub.io/license: Apache-2.0
  artifacthub.io/links: |
    - name: Support
      url: https://github.com/giantswarm/example/issues

--- helm/example/README.md.gotmpl
{{ template "chart.header" . }}
{{ template "chart.deprecationWarning" . }}

{{ template "chart.description" . }}

{{ template "chart.homepageLine" . }}

{{ template "chart.maintainersSection" . }}

{{ template "chart.sourcesSection" . }}

{{ template "chart.requirementsSection" . }}

{{ template "chart.valuesSection" . }}

--- helm/example/templates/_helpers.tpl
{{/* vim: set filetype=mustache: */}}
{{/*
Expand the name of the chart.
*/}}
{{- define "name" -}}
{{- .Chart.Name | trunc 63 | trimSuffix "-" -}}
{{- end -}}

{{/*
Create chart name and version as used by the chart label.
*/}}
{{- define "chart" -}}
{{- printf "%s-%s" .Chart.Name .Chart.Version | replace "+" "_" | trunc 63 | trimSuffix "-" -}}
{{- end -}}

{{/*
Common labels
*/}}
{{- define "labels.common" -}}
app: {{ include "name" . | quote }}
{{ include "labels.selector" . }}
app.kubernetes.io/managed-by: {{ .Release.Service | quote }}
app.kubernetes.io/version: {{ .Chart.AppVersion | quote }}
application.giantswarm.io/team: {{ index .Chart.Annotations "io.giantswarm.application.team" | quote }}
helm.sh/chart: {{ include "chart" . | quote }}
{{- end -}}

{{/*
Selector labels
*/}}
{{- define "labels.selector" -}}
app.kubernetes.io/name: {{ include "name" . | quote }}
app.kubernetes.io/instance: {{ .Release.Name | quote }}
{{- end -}}
<no newline at end of file>

--- helm/example/values.schema.json
{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": [
                "object",
                "null"
            ],
            "description": "Global values shared between all subcharts",
            "$comment": "Added automatically by 'helm schema' to allow this chart to be used as a Helm dependency, as this schema would otherwise not allow Helm's special 'global' values key."
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string"
                },
                "tag": {
                    "type": "string"
                }
            }
        },
        "provider": {
            "type": "string"
        },
        "registry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "domain": {
                    "type": "string"
                }
            }
        },
        "subscriptionID": {
            "type": "string"
        }
    }
}

--- helm/example/values.yaml
# This file is a Helm values file for the example chart.
#
# To learn more about how to configure your app on your cluster
# and override the default values in here, visit:
#
#   https://docs.giantswarm.io/tutorials/fleet-management/app-platform/app-configuration/#basic-values-merging-example
#
image:
  name: "giantswarm/example"
  tag: ""
registry:
  domain: gsoci.azurecr.io

--- helm/example/zz_generated.app-platform.values.yaml
# DO NOT EDIT. Generated with:
#
#    devctl
#
#    https://github.com/giantswarm/devctl/blob/<commit>/pkg/gen/input/precommit/internal/file/app-platform-values.yaml.template
#

# Values the Giant Swarm app platform injects into every App deployed to a
# workload cluster: flux/app-operator merge the <cluster>-cluster-values
# ConfigMap into the App's values. The chart does not have to consume them;
# this file only makes the generated values.schema.json accept them so an
# App-deployed chart does not fail schema validation on install/upgrade
# ("additional properties 'baseDomain', 'provider', ... not allowed").
#
# `helm schema` merges this file BEFORE the chart's values.yaml (see
# .schema.yaml), so any of these keys the chart defines itself keeps its own
# schema. Helm itself never reads this file; it only feeds schema generation.

baseDomain: ""
bootstrapMode: {}  # @schema skipProperties: true; additionalProperties: true
chartOperator: {}  # @schema skipProperties: true; additionalProperties: true
ciliumNetworkPolicy: {}  # @schema skipProperties: true; additionalProperties: true
cluster: {}  # @schema skipProperties: true; additionalProperties: true
clusterCA: ""
clusterCIDR: ""
clusterDNSIP: ""
clusterID: ""
gcpProject: ""
provider: ""
subscriptionID: ""

--- renovate.json5
// DO NOT EDIT. This file is generated by `devctl gen renovate` and kept in sync
// by the giantswarm/github align-files workflow. Repo-specific Renovate rules
// belong in renovate-custom.json5 (repo root) -- it is added as the last
// `extends` entry when present and never touched by devctl. Rules for a whole
// class of repos belong in giantswarm/renovate-presets instead.
{
  extends: [
    // Base config - https://github.com/giantswarm/renovate-presets/blob/main/default.json5
    'github>giantswarm/renovate-presets:default.json5',
    // ATS (app-test-suite) test deps - https://github.com/giantswarm/renovate-presets/blob/main/tests-ats.json5
    // Disables per-repo Renovate for tests/ats/Pipfile: that file is owned
    // centrally in giantswarm/devctl and regenerated by align-files, so per-repo
    // bumps would only fight the regeneration. Emitted on the generated path
    // (same condition as the architect orb disable below); a no-op for repos
    // without an ats/ Pipfile, so it is safe to extend for all generated-CI repos.
    'github>giantswarm/renovate-presets:tests-ats.json5',
  ],
  // Two of our own bots commit onto Renovate branches. taylorbot
  // <dev@giantswarm.io> pushes what the generated workflows produce
  // (zz_generated.helm-docs-regen.yaml, the update-chart and
  // sync-from-upstream flows). giantswarm-marge[bot] writes the bot PR's
  // changelog entry during the sweep, in the repositories that still cut a
  // release from CHANGELOG.md. Renovate treats a branch whose last commit is
  // by anyone else as edited by a human: it stops rebasing it and, on
  // autoclose, retitles the PR "- abandoned" instead of closing it. Listing
  // the authors here makes those commits Renovate's own. Renovate compares
  // the author email, so these are the bare addresses.
  gitIgnoredAuthors: [
    'dev@giantswarm.io',
    '329428426+giantswarm-marge[bot]@users.noreply.github.com',
  ],
  packageRules: [
    {
      // .circleci/config.yml is generated by `devctl gen circleci`, which bakes
      // in the giantswarm/architect orb version. Disable Renovate's orb updates
      // so they stop fighting the align-files regeneration.
      matchDatasources: [
        'orb',
      ],
      matchPackageNames: [
        'giantswarm/architect',
      ],
      enabled: false,
    },
  ],
}

--- tests/ats/pyproject.toml
# DO NOT EDIT. The canonical app-test-suite (ATS) test dependencies are owned
# centrally in giantswarm/devctl and generated into tests/ats/pyproject.toml and
# tests/ats/uv.lock for chart/app repos by `devctl gen circleci`. The stack is
# bumped by a single Renovate PR against the embedded source in giantswarm/devctl
# and propagated to every repo by the align-files regeneration. Per-repo Renovate
# updates of these files are disabled via
# github>giantswarm/renovate-presets:tests-ats.json5.
#
# ATS runs `uv sync` in this directory and `uv run pytest -m <scenario>`. Pins
# are exact == and chosen to resolve together: pytest must satisfy the pytest
# range pytest-helm-charts declares (1.3.5 requires pytest>=9.0.2,<10); uv.lock
# is resolved from this file (`uv lock` here) and proves the set resolves.
[project]
name = "ats-tests"
version = "0.1.0"
requires-python = ">=3.12"
dependencies = [
    "pytest-helm-charts==1.3.5",
    "pytest==9.1.1",
    "pykube-ng==23.6.0",
    "pytest-rerunfailures==16.6.1",
    "requests==2.34.2",
]

[tool.pytest.ini_options]
markers = [
    "smoke: fast sanity checks run first",
    "functional: full feature tests",
    "upgrade: run during upgrade scenario (before and after helm upgrade)",
]

--- tests/ats/uv.lock
version = 1
revision = 3
requires-python = ">=3.12"

[[package]]
name = "ats-tests"
version = "0.1.0"
source = { virtual = "." }
dependencies = [
    { name = "pykube-ng" },
    { name = "pytest" },
    { name = "pytest-helm-charts" },
    { name = "pytest-rerunfailures" },
    { name = "requests" },
]

[package.metadata]
requires-dist = [
    { name = "pykube-ng", specifier = "==23.6.0" },
    { name = "pytest", specifier = "==9.1.1" },
    { name = "pytest-helm-charts", specifier = "==1.3.5" },
    { name = "pytest-rerunfailures", specifier = "==16.6.1" },
    { name = "requests", specifier = "==2.34.2" },
]

