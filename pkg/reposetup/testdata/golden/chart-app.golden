### Checklist

- [ ] Update changelog in CHANGELOG.md.
- [ ] Make sure `values.yaml` and `values.schema.json` are valid.

--- .github/workflows/zz_generated.add-team-labels.yaml
name: Add appropriate labels to issue

on:
  issues:
    types: [assigned]

jobs:
  build_user_list:
    name: Get yaml config of GS users
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
    - name: Get user-mapping
      env:
        GH_TOKEN: ${{ secrets.ISSUE_AUTOMATION }}
      run: |
        mkdir -p artifacts
        gh api -H "Accept: application/vnd.github+json" -H "X-GitHub-Api-Version: 2022-11-28" \
          /repos/giantswarm/github/contents/tools/issue-automation/user-mapping.yaml \
          | jq -r '.content' \
          | base64 -d > artifacts/users.yaml
    - name: Upload Artifact
      uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
      with:
        name: users
        path: artifacts/users.yaml
        retention-days: 1

  add_label:
    name: Add team label when assigned
    runs-on: ubuntu-latest
    needs: build_user_list
    steps:
    - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c  # v8.0.1
      id: download-users
      with:
        name: users
    - name: Find team label based on user names
      run: |
        event_assignee=$(cat $GITHUB_EVENT_PATH | jq -r .assignee.login | tr '[:upper:]' '[:lower:]')
        echo "Issue assigned to: ${event_assignee}"

        TEAMS=$(cat ${{steps.download-users.outputs.download-path}}/users.yaml | tr '[:upper:]' '[:lower:]' | yq ".${event_assignee}.teams" -o csv | tr ',' ' ')

        echo "LABEL<<EOF" >> $GITHUB_ENV
        for team in ${TEAMS}; do
          echo "Team: ${team} | Label: team/${team}"
          echo "team/${team}" >> $GITHUB_ENV
        done
        echo "EOF" >> $GITHUB_ENV
    - name: Apply label to issue
      if: ${{ env.LABEL != '' && env.LABEL != 'null' && env.LABEL != null }}
      uses: actions-ecosystem/action-add-labels@18f1af5e3544586314bbe15c0273249c770b2daf  # v1.1.3
      with:
        github_token: ${{ secrets.ISSUE_AUTOMATION }}
        labels: |
          ${{ env.LABEL }}

--- .github/workflows/zz_generated.add-to-project-board.yaml
name: Add Issue to Project when assigned

on:
  issues:
    types:
    - assigned
    - labeled

jobs:
  build_user_list:
    name: Get yaml config of GS users
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
    - name: Get user-mapping
      env:
        GH_TOKEN: ${{ secrets.ISSUE_AUTOMATION }}
      run: |
        mkdir -p artifacts
        gh api -H "Accept: application/vnd.github+json" -H "X-GitHub-Api-Version: 2022-11-28" \
          /repos/giantswarm/github/contents/tools/issue-automation/user-mapping.yaml \
          | jq -r '.content' \
          | base64 -d > artifacts/users.yaml
    - name: Upload Artifact
      uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
      with:
        name: users
        path: artifacts/users.yaml
        retention-days: 1
    - name: Get label-mapping
      env:
        GH_TOKEN: ${{ secrets.ISSUE_AUTOMATION }}
      run: |
        mkdir -p artifacts
        gh api -H "Accept: application/vnd.github+json" -H "X-GitHub-Api-Version: 2022-11-28" \
          /repos/giantswarm/github/contents/tools/issue-automation/label-mapping.yaml \
          | jq -r '.content' \
          | base64 -d > artifacts/labels.yaml
    - name: Upload Artifact
      uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
      with:
        name: labels
        path: artifacts/labels.yaml
        retention-days: 1

  add_to_personal_board:
    name: Add issue to personal board
    runs-on: ubuntu-latest
    needs: build_user_list
    if: github.event.action == 'assigned'
    steps:
    - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c  # v8.0.1
      id: download-users
      with:
        name: users
    - name: Find personal board based on user names
      run: |
        event_assignee=$(cat $GITHUB_EVENT_PATH | jq -r .assignee.login | tr '[:upper:]' '[:lower:]')
        echo "Issue assigned to: ${event_assignee}"

        BOARD=($(cat ${{steps.download-users.outputs.download-path}}/users.yaml | tr '[:upper:]' '[:lower:]' | yq ".${event_assignee}.personalboard"))
        echo "Personal board URL: ${BOARD}"

        echo "BOARD=${BOARD}" >> $GITHUB_ENV
    - name: Add issue to personal board
      if: ${{ env.BOARD != 'null' && env.BOARD != ''  && env.BOARD != null }}
      uses: actions/add-to-project@5afcf98fcd03f1c2f92c3c83f58ae24323cc57fd # v2.0.0
      with:
        project-url: ${{ env.BOARD }}
        github-token: ${{ secrets.ISSUE_AUTOMATION }}

  add_to_team_board:
    name: Add issue to team board
    runs-on: ubuntu-latest
    needs: build_user_list
    if: github.event.action == 'labeled'
    steps:
    - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c  # v8.0.1
      id: download-labels
      with:
        name: labels
    - name: Find team board based on label
      run: |
        event_label=$(cat $GITHUB_EVENT_PATH | jq -r .label.name | tr '[:upper:]' '[:lower:]')
        echo "Issue labelled with: ${event_label}"

        BOARD=($(cat ${{steps.download-labels.outputs.download-path}}/labels.yaml | tr '[:upper:]' '[:lower:]' | yq ".[\"${event_label}\"].projectboard"))
        echo "Team board URL: ${BOARD}"

        echo "BOARD=${BOARD}" >> $GITHUB_ENV
    - name: Add issue to team board
      if: ${{ env.BOARD != 'null' && env.BOARD != '' && env.BOARD != null }}
      uses: actions/add-to-project@5afcf98fcd03f1c2f92c3c83f58ae24323cc57fd # v2.0.0
      with:
        project-url: ${{ env.BOARD }}
        github-token: ${{ secrets.ISSUE_AUTOMATION }}

--- .github/workflows/zz_generated.auto_release.yaml
# DO NOT EDIT. Generated with:
#
#    devctl
#
#    https://github.com/giantswarm/devctl/blob/<commit>/pkg/gen/input/workflows/internal/file/auto_release.yaml.template
#
# yamllint disable rule:truthy
# Push-based release tagger + release-page publisher.
#
# Runs on push to main (normal releases) and to backport branches
# (release-2.x, release-v3.7.x, etc. -- see `on:` block below for the
# exact pattern). Inspects conventional commits reachable from the pushed
# ref since the latest reachable v*.*.* tag via git-cliff, and:
#
#   1. creates a new vX.Y.Z git tag if a bump is warranted, or
#      vX.Y.Z-rc.N when the unreleased commits ask for a release candidate
#      (see the "Decide whether to tag" step for the rule)
#   2. creates the matching GitHub Release with notes generated by git-cliff,
#      flagged as a pre-release for a release candidate
#   3. checks that CircleCI picked the tag up and triggers the pipeline if
#      the webhook got lost (repos with a .circleci/config.yml only)
#
# The tag push then triggers downstream publishing (for chart/service/CLI
# repos, this is the CircleCI architect pipeline firing on the same /^v.*/
# tag filter -- go-build + push-to-registries + push-to-app-catalog +
# upload-release-assets as appropriate for the repo type). Architect appends
# any binary artifacts to the release we just created here.
#
# No release PR. No human approval step. The mechanism that protects against
# bad releases is the pre-merge CI on the feature PRs that landed these
# commits -- once they're on the branch, they ship.
name: Auto-release

on:
  push:
    branches:
      - main
      # Maintenance / backport branches. The character class anchors the
      # next char after "release-" to a digit or "v" so unrelated branches
      # that happen to start with "release-" don't trigger a release run.
      #
      # MATCHES:    release-2.x, release-2.3.x, release-v2.x, release-v3.7.x
      # NO MATCH:   release-notes, release-engineering, release-prep
      - 'release-[0-9]*'
      - 'release-v[0-9]*'
  # Manual escape hatch. `auto` applies the same rule as a push, which is what
  # a re-run wants. `stable` closes a release-candidate cycle when the last RC
  # is good and there is no pull request left to merge; `rc` forces one more.
  # Neither tags anything once the cycle has closed: both need something
  # unreleased on the branch.
  workflow_dispatch:
    inputs:
      release-type:
        description: 'Which kind of release to cut'
        type: choice
        options: [auto, rc, stable]
        default: auto

permissions:
  contents: write       # push tags and create the GitHub Release
  # git-cliff's GitHub API lookups (commit.remote.pr_number / username
  # in release notes) need PR read access via GITHUB_TOKEN.
  pull-requests: read

# Scope the concurrency lock per branch so a backport tag on release-2.x
# doesn't block (or get blocked by) a main release, and vice versa. A second
# push to the same branch while a tag is being computed still waits.
concurrency:
  group: auto-release-${{ github.ref_name }}
  cancel-in-progress: false

jobs:
  tag:
    name: Tag
    runs-on: ubuntu-24.04
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          fetch-depth: 0        # full history so git-cliff sees every commit
          fetch-tags: true      # ensure tags are present (shallow runners drop them by default)

      # Install git-cliff once and call it from shell so we can do all the
      # expensive work (commits walk + GitHub API PR lookups) in a single
      # invocation, then cheaply re-render from the cached JSON context.
      - name: Install git-cliff
        uses: giantswarm/install-binary-action@5bef88f65012037dd836117c8d344b21bb559854  # v4.1.0
        with:
          binary: git-cliff
          version: "2.13.1"
          # yamllint disable-line rule:line-length
          download_url: 'https://github.com/orhun/git-cliff/releases/download/v${version}/git-cliff-${version}-x86_64-unknown-linux-gnu.tar.gz'
          tarball_binary_path: 'git-cliff-${version}/git-cliff'
          smoke_test: '${binary} --version'

      - name: Compute next version
        id: cliff
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          # Single expensive call: walks commits, queries the GitHub API for
          # per-commit PR lookups, emits the JSON context for ONLY the bumped
          # release.
          #
          # Flag choice matters here. Both `--latest` and `--unreleased`
          # *look* like single-release filters, but only one composes with
          # `--bump`:
          #   --latest --bump : returns the latest EXISTING tag -- drops the
          #                     bump silently. We don't want this.
          #   --unreleased --bump : filters to commits that aren't in any tag
          #                         yet, computes the bumped version from
          #                         them, returns JSON for that bumped
          #                         release only. This is what we want.
          #
          # Without either filter, --bump --context returns the full release
          # history in JSON and the render step below would concatenate every
          # past release into each new release's notes.
          git-cliff --unreleased --bump --context > cliff-context.json
          NEXT=$(jq -r '.[0].version // empty' cliff-context.json)
          echo "next computed: ${NEXT:-<empty>}"
          echo "version=${NEXT}" >> "$GITHUB_OUTPUT"

      # feat-rc:/fix-rc: mark a change as belonging to a release candidate.
      # The decision is taken over EVERY unreleased commit, not just the ones
      # in this push:
      #
      #   Tag a release candidate when at least one unreleased commit is
      #   feat-rc/fix-rc, and no unreleased feat, fix or breaking commit
      #   lacks the -rc.
      #
      # feat and fix decide, everything else follows. That is what makes a
      # cycle sticky without any extra state: while every deciding commit
      # carries -rc, each merge produces the next rc.N, and the first
      # unmarked feat/fix closes the cycle at the stable version those RCs
      # were leading to. It also means an unmarked chore(deps) from Renovate
      # auto-merge cannot end a cycle on its own.
      #
      # git-cliff never sees the -rc: cliff.toml normalises the type away in a
      # commit_preprocessor, so `NEXT` below is always the STABLE target and
      # the patch/minor/major decision is untouched. The RC suffix is appended
      # here instead.
      - name: Decide whether to tag
        id: decide
        env:
          NEXT: ${{ steps.cliff.outputs.version }}
          WANT: ${{ inputs.release-type || 'auto' }}
          CLIFF_CONTEXT: cliff-context.json
        run: |
          set -euo pipefail
          # `git describe --tags --abbrev=0` returns the closest tag reachable
          # from HEAD -- NOT the highest tag in the repo overall. This matters
          # for backports: on release-2.x, HEAD's reachable history terminates
          # before v3.0.0 was tagged, so describe correctly returns v2.3.5
          # (the baseline of the 2.x line) and we end up tagging v2.3.6 rather
          # than something nonsensical relative to v3.0.0.
          #
          # The excludes hold this baseline to the tags cliff.toml's
          # `tag_pattern` counts as releases: `*-*` drops a pre-release name,
          # `*+*` a build-metadata one. A tag only one of the two recognises
          # splits `last` from `NEXT`, the `NEXT = last` comparison below can
          # never be true again, and the job tags on every push even when
          # there is nothing to release.
          last=$(git describe --tags --abbrev=0 --match='v*.*.*' --exclude='*-*' --exclude='*+*' 2>/dev/null || echo "")
          echo "branch: ${GITHUB_REF_NAME}"
          echo "last reachable stable tag: ${last:-<none>}"

          # Records are NUL-separated, so a multi-line body cannot be read as
          # the next commit. Inside a record the first line is the subject and
          # the rest is the body.
          marked=0
          blocking=0
          while IFS= read -r -d '' commit; do
            subject=${commit%%$'\n'*}
            # The two subject patterns are mutually exclusive: after "feat" the
            # second one needs "(", "!" or ":" and finds "-", so it never
            # matches a feat-rc subject.
            #
            # A breaking change counts whether it is declared by `!` in the
            # subject or by a `BREAKING CHANGE:`/`BREAKING-CHANGE:` footer in
            # the body: git-cliff bumps the major on either spelling, so both
            # have to be able to close a cycle. Miss the footer and the cycle
            # stays open on rc.N of a major version nobody marked.
            if printf '%s' "$subject" | grep -qE '^(feat|fix)-rc(\([^)]*\))?!?:'; then
              marked=$((marked + 1))
            elif printf '%s' "$subject" | grep -qE '^(feat|fix)(\([^)]*\))?!?:|^[a-z]+(\([^)]*\))?!:' \
              || printf '%s' "$commit" | grep -qE '^BREAKING[ -]CHANGE:'; then
              blocking=$((blocking + 1))
            fi
          done < <(git log ${last:+"${last}..HEAD"} -z --format='%s%n%b')
          echo "unreleased commits: ${marked} marked -rc, ${blocking} unmarked deciding"

          if [ "$marked" -gt 0 ] && [ "$blocking" -eq 0 ]; then
            is_rc=true
          else
            is_rc=false
          fi
          case "$WANT" in
            rc)     is_rc=true ;;
            stable) is_rc=false ;;
          esac

          # `NEXT` equal to `last` means nothing releasable landed since the
          # last stable release. A candidate needs an open cycle to extend and
          # there is none in that state, so this covers a forced `rc` too:
          # without it the run cuts ${last}-rc.$(( n + 1 )), a candidate for a
          # version that already shipped.
          if [ -z "${NEXT}" ] || [ "${NEXT}" = "${last}" ]; then
            echo "No releasable commits since ${last:-inception}; skipping tag."
            echo "tag=" >> "$GITHUB_OUTPUT"
            echo "prerelease=" >> "$GITHUB_OUTPUT"
            exit 0
          fi

          if [ "$is_rc" = true ]; then
            # Highest existing RC for this exact target, so a moved target
            # (a breaking change during a cycle) restarts at rc.1, and rc.9 is
            # followed by rc.10 rather than rc.2. `--merged HEAD` scopes the
            # search the way the describe baseline above is scoped: a candidate
            # for the same target cut on another branch must not shift the
            # numbering on this one.
            # `|| true`: grep exits 1 on the first candidate of a series,
            # when no ${NEXT}-rc.* tag exists yet, and pipefail would abort.
            n=$(git tag --list --merged HEAD "${NEXT}-rc.*" | sed 's/.*-rc\.//' | { grep -E '^[0-9]+$' || true; } | sort -n | tail -1)

            # A stable release refuses to tag when nothing releasable landed,
            # through the `NEXT = last` comparison above. The candidate path
            # needs its own form of that check: `NEXT` stays ahead of `last`
            # for the whole cycle, so without it every push cuts another
            # candidate, including a push that carries only commits git-cliff
            # skips (docs, style) or drops as non-conventional. That spends an
            # rc number, a GitHub pre-release and a publish pipeline on a
            # README typo.
            #
            # cliff-context.json holds exactly the commits git-cliff counted
            # for this release, so intersecting it with the range since the
            # last candidate needs no second copy of cliff.toml's skip rules.
            # An explicit `release-type: rc` overrides the check.
            if [ -n "${n}" ] && [ "$WANT" = auto ]; then
              counted=$(jq -r '.[0].commits[].id' "$CLIFF_CONTEXT")
              since=$(git rev-list "${NEXT}-rc.${n}..HEAD")
              fresh=0
              if [ -n "$counted" ] && [ -n "$since" ]; then
                fresh=$(printf '%s\n' "$since" | { grep -cxF "$counted" || true; })
              fi
              if [ "$fresh" -eq 0 ]; then
                echo "No releasable commits since ${NEXT}-rc.${n}; skipping tag."
                echo "tag=" >> "$GITHUB_OUTPUT"
                echo "prerelease=" >> "$GITHUB_OUTPUT"
                exit 0
              fi
            fi
            tag="${NEXT}-rc.$(( ${n:-0} + 1 ))"
          else
            tag="${NEXT}"
          fi
          echo "tag=${tag}" >> "$GITHUB_OUTPUT"
          echo "prerelease=${is_rc}" >> "$GITHUB_OUTPUT"

      # cliff-context.json names the stable target git-cliff bumped to, and
      # the tag actually cut is ${NEXT}-rc.N for a candidate. cliff.toml puts
      # `{{ version }}` in the "Full Changelog" compare link, so the context has
      # to carry the chosen tag before the render or the link points at a tag
      # that does not exist. The render reads the cached context, so the one
      # expensive git-cliff call above stays the only one.
      - name: Render release notes
        id: notes
        if: steps.decide.outputs.tag != ''
        env:
          TAG: ${{ steps.decide.outputs.tag }}
        run: |
          set -euo pipefail
          # `error` rather than a silent `[{version: $tag}]`: jq builds that
          # object out of an empty context, and the render would then produce
          # empty notes for a tag that is about to be created.
          jq --arg tag "$TAG" \
            'if (.[0].version // "") == "" then error("cliff-context.json carries no version") else .[0].version = $tag end' \
            cliff-context.json > cliff-context.tagged.json
          # Cheap render from the cached context -- no API calls, no git walk.
          # `--strip all` drops header/footer; body-only is what gh release
          # create --notes-file expects.
          git-cliff --from-context cliff-context.tagged.json --strip all --output release-notes.md

      # Create the tag AND the GitHub Release in one atomic API call. GitHub's
      # release-create endpoint accepts a tag_name + target_commitish and, if
      # the tag doesn't already exist, creates it pointing at that commitish
      # as part of the same operation. Either both exist or neither does --
      # no risk of a tag-without-release "stuck" state, no race window with
      # CircleCI's `upload-release-assets` job that starts polling the
      # release the instant it sees the tag.
      #
      # Trade-off: the tag created this way is **lightweight** (just a ref),
      # not annotated. For our use -- git describe, architect's tag filter,
      # gitsemver, gh release view -- both behave identically. Nothing in the
      # giantswarm stack distinguishes them.
      - name: Create release (and the tag, atomically)
        id: release
        if: steps.decide.outputs.tag != ''
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          GH_REPO: ${{ github.repository }}
          TAG: ${{ steps.decide.outputs.tag }}
          PRERELEASE: ${{ steps.decide.outputs.prerelease }}
        run: |
          set -euo pipefail
          # A release candidate is flagged as a GitHub pre-release so it does
          # not surface as the repository's "Latest release".
          flags=()
          if [ "$PRERELEASE" = "true" ]; then
            flags+=(--prerelease)
          fi
          gh release create "$TAG" \
            --title "$TAG" \
            --notes-file release-notes.md \
            --target "$GITHUB_SHA" \
            "${flags[@]}"

      # A tag that never reaches CircleCI is a silent failure: the GitHub
      # Release above exists and looks finished, but nothing gets built or
      # published. GitHub delivers the tag-push webhook exactly once and never
      # retries it; on 2026-09-04 ~22:00 UTC CircleCI's receiver answered
      # three of ~55 tag pushes with an empty HTTP 400 and those releases had
      # no pipeline until somebody noticed. So ask CircleCI directly: poll its
      # pipeline list for this tag and, if nothing shows up, trigger the
      # pipeline through the API.
      #
      # CIRCLECI_API_TOKEN is an org-level secret holding a CircleCI personal
      # API token (a machine account's -- CircleCI's v2 API accepts no other
      # kind for triggering, and needs one to read private projects). Without
      # it the step still reads public projects and stays a detector: a
      # missing pipeline fails the run with the exact command to fix it by
      # hand. Private projects and repos without a CircleCI project both read
      # as 404 unauthenticated, so without the token that case is a warning.
      #
      # Only a positively observed empty list (HTTP 200) triggers: a CircleCI
      # API outage fails the step instead of risking a second pipeline on the
      # tag, which would race the image and chart pushes.
      - name: Verify CircleCI picked up the tag
        if: steps.decide.outputs.tag != '' && hashFiles('.circleci/config.yml') != ''
        env:
          TAG: ${{ steps.decide.outputs.tag }}
          CIRCLECI_API_TOKEN: ${{ secrets.CIRCLECI_API_TOKEN }}
          # A healthy CircleCI creates the pipeline 1-2 s after the tag push.
          CIRCLECI_PIPELINE_WAIT_SECONDS: "120"
        run: |
          set -euo pipefail
          api="https://circleci.com/api/v2/project/gh/${GITHUB_REPOSITORY}/pipeline"
          auth=()
          if [ -n "${CIRCLECI_API_TOKEN}" ]; then
            auth=(-H "Circle-Token: ${CIRCLECI_API_TOKEN}")
          fi
          manual="curl -X POST -H 'Circle-Token: <token>' -H 'Content-Type: application/json' -d '{\"tag\":\"${TAG}\"}' ${api}"

          deadline=$((SECONDS + CIRCLECI_PIPELINE_WAIT_SECONDS))
          last_code=""
          found=""
          while :; do
            # Newest first; the tag pipeline is created within seconds of the
            # push, so two pages (40 pipelines) cover even a merge burst.
            url="$api"
            pages=0
            while [ -n "$url" ] && [ "$pages" -lt 2 ]; do
              resp=$(curl -sS "${auth[@]}" -w '\n%{http_code}' "$url" || printf '\n000')
              last_code=${resp##*$'\n'}
              body=${resp%$'\n'*}
              [ "$last_code" = "200" ] || break
              found=$(jq -r --arg tag "$TAG" '[.items[] | select(.vcs.tag == $tag)][0] | select(. != null) | .number' <<<"$body")
              [ -z "$found" ] || break
              next=$(jq -r '.next_page_token // empty' <<<"$body")
              url=${next:+"${api}?page-token=${next}"}
              pages=$((pages + 1))
            done
            if [ -n "$found" ]; then
              echo "CircleCI pipeline #${found} exists for ${TAG}: https://app.circleci.com/pipelines/github/${GITHUB_REPOSITORY}/${found}"
              exit 0
            fi
            case "$last_code" in
              200) ;;                       # positively empty; keep waiting
              404|401|403) break ;;         # will not change by waiting
            esac
            if [ "$SECONDS" -ge "$deadline" ]; then
              break
            fi
            echo "no CircleCI pipeline for ${TAG} yet (HTTP ${last_code}); retrying in 10 s"
            sleep 10
          done

          case "$last_code" in
            200)
              if [ -z "${CIRCLECI_API_TOKEN}" ]; then
                echo "::error::CircleCI never built ${TAG}: no pipeline ${CIRCLECI_PIPELINE_WAIT_SECONDS} s after the tag push" \
                  "(GitHub delivers the webhook once and never retries) and no CIRCLECI_API_TOKEN secret to trigger one." \
                  "Fix by hand: ${manual}"
                exit 1
              fi
              echo "CircleCI never built ${TAG}; triggering the pipeline through the API"
              resp=$(curl -sS "${auth[@]}" -w '\n%{http_code}' -X POST -H 'Content-Type: application/json' -d "{\"tag\":\"${TAG}\"}" "$api" || printf '\n000')
              code=${resp##*$'\n'}
              body=${resp%$'\n'*}
              if [ "$code" != "201" ]; then
                echo "::error::triggering the CircleCI pipeline for ${TAG} failed (HTTP ${code}): ${body}"
                exit 1
              fi
              number=$(jq -r .number <<<"$body")
              echo "triggered CircleCI pipeline #${number} for ${TAG}: https://app.circleci.com/pipelines/github/${GITHUB_REPOSITORY}/${number}"
              ;;
            404)
              if [ -z "${CIRCLECI_API_TOKEN}" ]; then
                echo "::warning::cannot verify that CircleCI built ${TAG}: ${api} answers 404 without a token" \
                  "(private project, or no CircleCI project for this repo)." \
                  "Set the CIRCLECI_API_TOKEN org secret to make this check real."
                exit 0
              fi
              # The first tag of a repository created pull-request-last lands
              # before the repository set-up reconciler follows the project on
              # CircleCI; the reconciler triggers the missed tag build once it
              # has. Following takes an administrator's token this workflow does
              # not hold, so this is not the workflow's to fix.
              echo "::warning::${TAG} is released; CircleCI does not follow this project yet." \
                "The repository set-up reconciler follows it and triggers this tag's build within minutes —" \
                "check the tag's pipeline on CircleCI after that: https://app.circleci.com/pipelines/github/${GITHUB_REPOSITORY}"
              exit 0
              ;;
            401|403)
              echo "::error::CircleCI rejected CIRCLECI_API_TOKEN (HTTP ${last_code}); cannot verify that ${TAG} was built."
              exit 1
              ;;
            *)
              echo "::error::could not reach the CircleCI API (last HTTP ${last_code}) within ${CIRCLECI_PIPELINE_WAIT_SECONDS} s;" \
                "cannot verify that ${TAG} was built. Not triggering blindly (a second pipeline on the tag would race" \
                "the image and chart pushes). Check https://app.circleci.com/pipelines/github/${GITHUB_REPOSITORY}" \
                "and, if the tag is missing: ${manual}"
              exit 1
              ;;
          esac

