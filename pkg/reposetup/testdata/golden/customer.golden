#
#    https://github.com/giantswarm/devctl/blob/<commit>/pkg/gen/input/workflows/internal/file/validate_changelog.yaml.template
#
name: Validate changelog

on:
  pull_request:
    types: [opened, synchronize, reopened]
    paths:
      - 'CHANGELOG.md'

permissions: {}

jobs:
  validate-changelog:
    uses: giantswarm/github-workflows/.github/workflows/validate-changelog.yaml@main
    permissions:
      contents: read
      pull-requests: write

