--- .github/workflows/zz_generated.create_release.yaml
# DO NOT EDIT. Generated with:
#
#    devctl
#
#    https://github.com/giantswarm/devctl/blob/<commit>/pkg/gen/input/workflows/internal/file/create_release.yaml.template
#
name: Create Release

on:
  push:
    branches:
      - 'legacy'
      - 'main'
      - 'master'
      - 'release-v*.*.x'
      # "!" negates previous positive patterns so it has to be at the end.
      - '!release-v*.x.x'

permissions: {}

jobs:
  create-release:
    uses: giantswarm/github-workflows/.github/workflows/create-release.yaml@main
    with:
      fetch-deep-gitlog-for-build: true
    secrets:
      RELEASE_BOT_CLIENT_ID: ${{ secrets.RELEASE_BOT_CLIENT_ID }}
      RELEASE_BOT_PRIVATE_KEY: ${{ secrets.RELEASE_BOT_PRIVATE_KEY }}
    permissions:
      contents: write

--- .github/workflows/zz_generated.create_release_pr.yaml
# DO NOT EDIT. Generated with:
#
#    devctl
#
#    https://github.com/giantswarm/devctl/blob/<commit>/pkg/gen/input/workflows/internal/file/create_release_pr.yaml.template
#
name: Create Release PR
on:
  push:
    branches:
      - 'legacy#release#v*.*.*'
      - 'main#release#v*.*.*'
      - 'main#release#major'
      - 'main#release#minor'
      - 'main#release#patch'
      - 'main#release#major-rc'
      - 'main#release#minor-rc'
      - 'main#release#patch-rc'
      - 'main#release#rc'
      - 'main#release#rc-release'
      - 'master#release#v*.*.*'
      - 'master#release#major'
      - 'master#release#minor'
      - 'master#release#patch'
      - 'master#release#major-rc'
      - 'master#release#minor-rc'
      - 'master#release#patch-rc'
      - 'master#release#rc'
      - 'master#release#rc-release'
      - 'release#v*.*.*'
      - 'release#major'
      - 'release#minor'
      - 'release#patch'
      - 'release#major-rc'
      - 'release#minor-rc'
      - 'release#patch-rc'
      - 'release#rc'
      - 'release#rc-release'
      - 'release-v*.*.x#release#v*.*.*'
      # "!" negates previous positive patterns so it has to be at the end.
      - '!release-v*.x.x#release#v*.*.*'
  workflow_call:
    inputs:
      branch:
        required: true
        type: string

permissions: {}

jobs:
  publish:
    uses: giantswarm/github-workflows/.github/workflows/create-release-pr.yaml@main
    permissions:
      contents: read
    with:
      branch: ${{ inputs.branch }}
    secrets:
      RELEASE_BOT_CLIENT_ID: ${{ secrets.RELEASE_BOT_CLIENT_ID }}
      RELEASE_BOT_PRIVATE_KEY: ${{ secrets.RELEASE_BOT_PRIVATE_KEY }}

--- .github/workflows/zz_generated.gitleaks.yaml
# DO NOT EDIT. Generated with:
#
#    devctl
#
#    https://github.com/giantswarm/devctl/blob/<commit>/pkg/gen/input/workflows/internal/file/gitleaks.yaml.template
#
name: gitleaks

on:
  - pull_request
  - merge_group

permissions: {}

concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

jobs:
  publish:
    uses: giantswarm/github-workflows/.github/workflows/gitleaks.yaml@main
    permissions:
      contents: read

--- .github/workflows/zz_generated.semantic_pull_request.yaml
# DO NOT EDIT. Generated with:
#
#    devctl
#
#    https://github.com/giantswarm/devctl/blob/<commit>/pkg/gen/input/workflows/internal/file/semantic_pull_request.yaml.template
#
name: semantic-pull-request

on:
  pull_request:
    types:
      - opened
      - edited
      - synchronize
  merge_group: {}

permissions: {}

concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

jobs:
  semantic-pull-request:
    uses: giantswarm/github-workflows/.github/workflows/semantic-pull-request.yaml@main
    permissions:
      pull-requests: read
    with:
      # `types` REPLACES the action's default list rather than extending it, so
      # all eleven defaults from commitizen/conventional-commit-types are
      # repeated here, plus the additions below. Entries are regexes the action
      # wraps in `^ $`.
      #
      # `security` is not one of the action's defaults and has to be listed to
      # be accepted at all. cliff.toml maps it to the Security changelog group,
      # which no title can reach while the type is rejected.
      types: |
        feat
        fix
        docs
        style
        refactor
        perf
        test
        build
        ci
        chore
        revert
        security

--- .github/workflows/zz_generated.validate_changelog.yaml
# DO NOT EDIT. Generated with:
#
#    devctl
#
#    https://github.com/giantswarm/devctl/blob/<commit>/pkg/gen/input/workflows/internal/file/validate_changelog.yaml.template
#
name: Validate changelog

on:
  pull_request:
    types: [opened, synchronize, reopened]
    paths:
      - 'CHANGELOG.md'
      - '.github/workflows/zz_generated.auto_release.yaml'
      - 'cliff.toml'

permissions: {}

jobs:
  validate-changelog:
    uses: giantswarm/github-workflows/.github/workflows/validate-changelog.yaml@main
    permissions:
      contents: read
      pull-requests: write

  # This repository's declaration in giantswarm/github says the legacy release
  # workflow, so the next align-files run deletes the Auto Release files again.
  release-workflow-declaration:
    name: Release workflow matches the declaration
    runs-on: ubuntu-26.04
    permissions:
      contents: read
    steps:
      - name: Checkout code
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          sparse-checkout: .github/workflows
      - name: Refuse Auto Release files under a legacy declaration
        run: |
          found=""
          for f in .github/workflows/zz_generated.auto_release.yaml cliff.toml; do
            if [ -e "$f" ]; then
              found="$found $f"
            fi
          done
          if [ -n "$found" ]; then
            echo "::error::This repository is declared on the legacy release workflow, so align-files deletes${found} again. Auto Release is enabled in the repository's entry in giantswarm/github: set gen.ci.releaseWorkflow: auto-release there and let align-files generate the files, instead of adding them in this pull request."
            exit 1
          fi

--- AGENTS.md
<!-- BEGIN devctl-managed: generated by devctl from https://github.com/giantswarm/devctl/blob/main/pkg/gen/input/llm/internal/file/agents_block.md.template, edits in this block are overwritten -->
## Giant Swarm conventions

devctl maintains this block and overwrites changes to it. Instructions for this repository go in the section below. Where they differ from this block, they take precedence.

- Never put customer names or other customer information in code, commit messages, issues or pull requests. Most Giant Swarm repositories are public, and private ones are kept ready to become public.
- Giant Swarm's style guides are in https://github.com/giantswarm/fmt, one directory per topic (go, helm, kubernetes, prometheus, …). Read the relevant guide before you write or review that kind of code.
- Use conventional commits for commit messages and pull request titles.
- If `.github/workflows/zz_generated.auto_release.yaml` exists, GitHub Releases are written from pull request titles: do not edit CHANGELOG.md. Otherwise, add your change to CHANGELOG.md as described in https://github.com/giantswarm/fmt/blob/main/releases/changelog.md.
- If `.pre-commit-config.yaml` exists, run `pre-commit run --files <changed files>` before committing; not every clone has the hooks installed.
- Do not add linters, formatters or other tooling unless asked; use what the repository already has.
- Put documentation in `docs/` rather than growing README.md, which gives an overview and links into `docs/`. When a change affects documented behaviour, update the documentation in the same pull request.
- If the skills of the `giantswarm/claude-code` plugin marketplace are not available to you and the user works at Giant Swarm, tell them once that they can install the `gs-base` and `gs-dev` plugins from it.
<!-- END devctl-managed -->

# AGENTS.md

Agent-facing notes for working in example-plans, the plans repository of
@giantswarm/team-cabbage. Human-facing docs live in README.md.

Each plan is its own top-level directory holding a PRD.md and a companion
index.html website.

