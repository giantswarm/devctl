--- renovate.json5
// DO NOT EDIT. This file is generated by `devctl gen renovate` and kept in sync
// by the giantswarm/github align-files workflow. Repo-specific Renovate rules
// belong in renovate-custom.json5 (repo root) -- it is added as the last
// `extends` entry when present and never touched by devctl. Rules for a whole
// class of repos belong in giantswarm/renovate-presets instead.
{
  extends: [
    // Base config - https://github.com/giantswarm/renovate-presets/blob/main/default.json5
    'github>giantswarm/renovate-presets:default.json5',
  ],
  // Our automation commits onto Renovate branches. The giantswarm-release
  // GitHub App pushes what the generated workflows produce
  // (zz_generated.helm-docs-regen.yaml, the update-chart and
  // sync-from-upstream flows); taylorbot <dev@giantswarm.io> did so before
  // it and still does in repositories whose workflows are not regenerated
  // yet. giantswarm-marge[bot] writes the bot PR's
  // changelog entry during the sweep, in the repositories that still cut a
  // release from CHANGELOG.md. Renovate treats a branch whose last commit is
  // by anyone else as edited by a human: it stops rebasing it and, on
  // autoclose, retitles the PR "- abandoned" instead of closing it. Listing
  // the authors here makes those commits Renovate's own. Renovate compares
  // the author email, so these are the bare addresses.
  gitIgnoredAuthors: [
    '342014845+giantswarm-release[bot]@users.noreply.github.com',
    'dev@giantswarm.io',
    '329428426+giantswarm-marge[bot]@users.noreply.github.com',
  ],
  packageRules: [
    {
      // The .github/workflows/zz_generated.* workflows are generated by devctl,
      // which sets their runner image. Disable Renovate's runner updates there
      // so they stop fighting the align-files regeneration.
      matchFileNames: [
        '.github/workflows/zz_generated.*',
      ],
      matchDatasources: [
        'github-runners',
      ],
      enabled: false,
    },
  ],
}
