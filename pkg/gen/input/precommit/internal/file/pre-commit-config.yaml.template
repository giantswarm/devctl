{{ .Header }}
minimum_pre_commit_version: '2.17'
default_install_hook_types: [pre-commit, commit-msg{{ if .NodeDevLintHook }}, pre-push{{ end }}]
# Protobuf-generated code (protoc, buf: *_pb.ts, *_pb.js, *_pb2.py,
# *_pb2_grpc.py, *.pb.go, *_grpc.pb.go) belongs to its generator: a hook that
# rewrote it (end-of-file-fixer, go-imports, ruff --fix) would be undone by
# the next generation, so no hook reads it.
exclude: "(_pb2?|\\.pb)(_grpc)?\\.[^/]+$"
repos:
  # base hooks
  #
  # helm/<chart>/charts/ holds vendored upstream subcharts (vendir-synced).
  # Those files are not repo-authored: the auto-fixing hooks would rewrite
  # them on every vendir bump and the next vendir sync would revert the fix,
  # so the whitespace/shebang/private-key hooks skip the vendored subtree.
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      - id: check-merge-conflict
      - id: check-shebang-scripts-are-executable
        exclude: "^helm/[^/]+/charts/.*"
      - id: detect-private-key
        # Upstream charts document key formats with placeholder PEM headers
        # (redis-ha's restore.ssh.key example) that the hook cannot tell from
        # a key; gitleaks stays the scanner of record for the vendored subtree.
        exclude: "^helm/[^/]+/charts/.*"
      - id: end-of-file-fixer
        exclude: "(.*testdata/.*|^\\.yarn/.*|^helm/[^/]+/charts/.*)"
      - id: mixed-line-ending
        exclude: "^helm/[^/]+/charts/.*"
      - id: trailing-whitespace
        exclude: "(.*testdata/.*|^\\.yarn/.*|^helm/[^/]+/charts/.*)"

  - repo: https://github.com/compilerla/conventional-pre-commit
    rev: v4.4.0
    hooks:
      - id: conventional-pre-commit
        stages: [commit-msg]
        args: [--strict]
{{- if .NodeDevLintHook }}

  # Dev-only Node lint. Runs the repo's standard `ci:lint` script (a single
  # convention name, like ci:verify/ci:build, that the repo defines pointing at
  # its own eslint/prettier toolchain, resolved against the installed
  # node_modules) at the PRE-PUSH stage, so the CI pre-commit job -- which runs
  # `pre-commit run --all-files` at the pre-commit stage on a runner with no
  # node_modules -- never executes it. CI lint/format run in ci:verify (which
  # composes ci:lint) instead; lint/format are therefore verify-canonical (here
  # for fast dev feedback, ci:verify for the gate) and never in the CI
  # pre-commit job. See the node-precommit-single-source and
  # node-ci-verify-build-single-pass ADRs.
  - repo: local
    hooks:
      - id: ci-lint
        name: ci:lint (dev-only, pre-push)
        entry: {{ .NodeRunPrefix }} ci:lint
        language: system
        pass_filenames: false
        stages: [pre-push]
{{- end }}
{{- if eq .Language "python" }}

  # Python hooks
  - repo: https://github.com/astral-sh/ruff-pre-commit
    # Ruff version.
    rev: v0.15.6
    hooks:
      # Run the linter.
      - id: ruff-check
        args: [--fix]
      # Run the formatter.
      - id: ruff-format

  # static type checking with mypy
  - repo: https://github.com/pre-commit/mirrors-mypy
    rev: v2.3.1
    hooks:
      - id: mypy
{{- end }}
{{- if eq .Language "go" }}

  # Go hooks
  - repo: https://github.com/dnephin/pre-commit-golang
    rev: v0.5.1
    hooks:
      - id: go-fmt
      - id: go-mod-tidy
      - id: golangci-lint
        args:
          - -E=gosec
          - -E=goconst
          - -E=govet
          # timeout is needed for CI
          - --timeout=300s
          # List all issues found
          - --max-same-issues=0
          - --max-issues-per-linter=0
      - id: go-imports
        args: [ -local, {{.RepoName}} ]
{{- end }}
{{- if .HasBash }}

  # Bash/shell hooks
  - repo: https://github.com/detailyang/pre-commit-shell
    rev: 'v1.0.6'
    hooks:
      - id: shell-lint
        args: [ --format=json ]
        exclude: ".*\\.template"
{{- end }}
{{- if .HasMd }}

  # Markdown hooks
  - repo: https://github.com/igorshubovych/markdownlint-cli
    rev: v0.49.1
    hooks:
      - id: markdownlint
{{- end }}
{{- if .HasHelmchart }}
{{- range .HelmCharts }}

  # Helm chart schema for {{.}}: verify helm/{{.}}/values.schema.json is up to date.
  #
  # `devctl gen precommit` now generates and writes helm/{{.}}/values.schema.json itself
  # (running the same generate -> fix $ref -> normalize pipeline in-process, see
  # giantswarm/devctl#2195), so this hook is READ-ONLY: it reproduces that pipeline to a
  # scratch file and diffs it against the committed one, but never writes the committed
  # file. A hook that regenerated files in place used to fight `schemalint-verify` and
  # itself over key ordering, because pre-commit runs each hook independently against the
  # file on disk and fails the run if any hook modifies it (giantswarm/giantswarm#37267);
  # a read-only check has no resting format to fight over.
  #
  # The `$ref` step works around a generator bug: with `noAdditionalProperties: true` it
  # emits `additionalProperties: false` as a sibling of every bare `$ref`. Per JSON Schema
  # 2020-12, `additionalProperties` only sees sibling `properties`/`patternProperties`
  # -- NOT properties pulled in through `$ref` -- so it wrongly rejects every field the
  # referenced schema defines (e.g. `helm template` fails with "additional properties
  # 'podAntiAffinity' not allowed" for a k8s Affinity). The correct 2020-12 keyword is
  # `unevaluatedProperties`, which DOES consider $ref-evaluated properties, but the tool
  # cannot emit it and does not drop the bogus `additionalProperties` when annotated. So
  # for every object that has both `$ref` and `additionalProperties: false` we drop
  # `additionalProperties` and set `unevaluatedProperties: false`.
  # Upstream bug: https://github.com/losisin/helm-values-schema-json/issues/317
  #
  # BOTH binaries are installed and pinned by the hook itself (`additional_dependencies`,
  # hence `language: golang`), at the exact versions devctl's own go.mod requires (stamped
  # in by the generator, not hardcoded here), so this reproduction runs the same versions
  # devctl used to write the committed file.
  #
  # `helm-values-schema-json` is the module behind the `helm schema` plugin -- the very
  # same binary, called directly, so nothing here depends on a helm plugin. It used to:
  # the hook called a bare `helm schema`, resolved from whatever the developer had in
  # their global helm plugin dir, while CI pinned a version in a different file. The old
  # guard only checked that *a* plugin existed, never which version, so a wrong version
  # printed "Passed" locally while rewriting the committed schema (v2.6.0 alone strips 41
  # lines from hello-world-app's) and CI then rejected it.
  - repo: local
    hooks:
      - id: helm-schema-{{.}}
        name: "verify helm/{{.}}/values.schema.json is up to date"
        language: golang
        additional_dependencies: ['github.com/giantswarm/schemalint/v2@{{ $.SchemalintVersion }}', 'github.com/losisin/helm-values-schema-json/v2@{{ $.HelmValuesSchemaJSONVersion }}']
        files: ^helm/{{.}}/(values\.yaml|\.schema\.yaml|values\.schema\.json|zz_generated\.app-platform\.values\.yaml)$
        pass_filenames: false
        require_serial: true
        entry: sh -c
        args:
          - |
            set -e
            tmp=$(mktemp)
            trap 'rm -f "$tmp"' EXIT
            helm-values-schema-json --config helm/{{.}}/.schema.yaml -o "$tmp"
            python3 -c '{{ $.RefFixPython }}' "$tmp"
            schemalint normalize "$tmp" -o "$tmp" --force
            if ! diff -u helm/{{.}}/values.schema.json "$tmp"; then
              echo "helm/{{.}}/values.schema.json is out of date -- run 'devctl gen precommit' and commit the result" >&2
              exit 1
            fi
{{- /* `rev:` is stamped from the same go.mod pin as the hook above, not a literal: it is
a git tag, and the module version of a module rooted at the repo root IS that tag, so the
normalizing binary cannot drift from the verifying one (giantswarm/giantswarm#37267).
A template comment, so the generated config stays byte-identical to the old literal. */}}
  - repo: https://github.com/giantswarm/schemalint
    rev: {{ $.SchemalintVersion }}
    hooks:
      - id: schemalint-verify
        pass_filenames: false
        args:
          - helm/{{.}}/values.schema.json
{{- end }}
  - repo: https://github.com/norwoodj/helm-docs
    rev: "v1.14.2"
    hooks:
      - id: helm-docs
        args:
          - --chart-search-root=helm
          - --sort-values-order=file
{{- end }}
