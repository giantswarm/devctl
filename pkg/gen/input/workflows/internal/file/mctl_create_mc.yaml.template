# `/create-mc` on an init PR merges the CCR PR (Flux reads it during bootstrap) and fires the Tekton mctl-create-mc pipeline.

name: Create MC

on:
  issue_comment:
    types: [created]

permissions:
  contents: read
  pull-requests: write
  issues: write

env:
  MCTL_IMAGE: ${{ vars.MCTL_IMAGE || 'gsoci.azurecr.io/giantswarm/mctl:{{{{ .MctlVersion }}}}' }}

jobs:
  trigger:
    name: Trigger Tekton pipeline
    runs-on: ubuntu-latest
    # Not in the template repo; only /create-mc from members (it starts a cluster-admin pipeline), not the trigger comment.
    if: >
      github.repository != 'giantswarm/template-management-clusters' &&
      github.event.issue.pull_request != null &&
      startsWith(github.event.comment.body, '/create-mc') &&
      !contains(github.event.comment.body, 'INSTALLATION=') &&
      contains(fromJSON('["OWNER", "MEMBER", "COLLABORATOR"]'), github.event.comment.author_association)

    steps:
      - name: Acknowledge comment
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        with:
          script: |
            await github.rest.reactions.createForIssueComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              comment_id: context.payload.comment.id,
              content: 'eyes',
            });

      - name: Get PR branch
        id: pr
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        with:
          script: |
            const pr = await github.rest.pulls.get({
              owner: context.repo.owner,
              repo: context.repo.repo,
              pull_number: context.issue.number,
            });
            // Init branches live in this repository, never in a fork.
            if (pr.data.head.repo?.full_name !== pr.data.base.repo.full_name) {
              core.setFailed(`/create-mc only runs on a cluster init PR, not on a PR from ${pr.data.head.label}.`);
              return;
            }
            core.setOutput('branch', pr.data.head.ref);

      - name: Derive installation name
        id: install
        env:
          BRANCH: ${{ steps.pr.outputs.branch }}
        run: |
          # {installation}-init or {installation}-init-{provider}; any other PR is not a cluster init PR.
          if [[ "$BRANCH" =~ ^(.+)-init-(capa|capz|capv|capvcd)$ ]] || [[ "$BRANCH" =~ ^(.+)-init$ ]]; then
            installation="${BASH_REMATCH[1]}"
          else
            echo "::error::/create-mc only runs on a cluster init PR, not on branch $BRANCH."
            exit 1
          fi
          echo "name=$installation" >> "$GITHUB_OUTPUT"

      # A failed job alone is easy to miss; the token is not minted for these PRs.
      - name: Report not an init PR
        if: failure() && (steps.pr.outcome == 'failure' || steps.install.outcome == 'failure')
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        with:
          script: |
            await github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.issue.number,
              body: '### ❌ `/create-mc` stopped\n\n`/create-mc` only runs on a cluster init PR: ' +
                'a branch of this repository named `<installation>-init` or `<installation>-init-<provider>`.',
            });

      - name: Generate app token
        id: app-token
        uses: actions/create-github-app-token@64ab729a6294000f5aa4a4bc0b73d1f32bc45510 # v3.3.0
        with:
          app-id: ${{ secrets.MCTL_APP_ID }}
          private-key: ${{ secrets.MCTL_APP_PRIVATE_KEY }}
          # Owner-scoped so cross-repo calls work.
          owner: ${{ github.repository_owner }}

      # URLs come from the `**CCR PR:**` / `**Installations PR:**` lines the config workflow posts.
      - name: Merge CCR PR
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        env:
          INSTALLATION: ${{ steps.install.outputs.name }}
        with:
          github-token: ${{ steps.app-token.outputs.token }}
          script: |
            const installation = process.env.INSTALLATION;
            const comments = await github.paginate(
              github.rest.issues.listComments,
              {
                owner: context.repo.owner,
                repo: context.repo.repo,
                issue_number: context.issue.number,
              }
            );

            // Anyone who can read the repo can comment, so markers only count from the workflows'
            // bots and from people with write access (a local `mctl create mc` posts as its operator).
            const MARKER_BOTS = ['github-actions[bot]', 'giantswarm-mctlbot[bot]', 'tinkerers-ci[bot]'];
            const canWrite = new Map();
            async function trustedAuthor(c) {
              const login = c.user?.login;
              if (!login) return false;
              if (MARKER_BOTS.includes(login)) return c.user.type === 'Bot';
              if (c.user.type !== 'User') return false;
              if (!canWrite.has(login)) {
                let ok = false;
                try {
                  const { data } = await github.rest.repos.getCollaboratorPermissionLevel({
                    owner: context.repo.owner, repo: context.repo.repo, username: login,
                  });
                  // maintain is reported as write.
                  ok = ['admin', 'write'].includes(data.permission);
                } catch (err) {
                  core.warning(`Could not read the permission of ${login}: ${err.message}`);
                }
                canWrite.set(login, ok);
              }
              return canWrite.get(login);
            }
            const trusted = [];
            for (const c of comments) {
              if (await trustedAuthor(c)) trusted.push(c);
            }

            // Anchored on the labelled line, newest trusted comment first.
            function findLabelled(label) {
              for (let i = trusted.length - 1; i >= 0; i--) {
                const m = (trusted[i].body || '').match(
                  new RegExp('\\*\\*' + label + ':\\*\\* (https://github\\.com/\\S+)')
                );
                if (m) return m[1];
              }
              return null;
            }

            // Report on the init PR too: a failed job alone is easy to miss.
            async function fail(message) {
              core.setFailed(message);
              await github.rest.issues.createComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                issue_number: context.issue.number,
                body: `### ❌ \`/create-mc\` stopped\n\n${message}`,
              });
            }

            // Installations PR is merged later; a missing one means config never ran.
            const ccrURL  = findLabelled('CCR PR');
            const instURL = findLabelled('Installations PR');

            if (!ccrURL || !instURL) {
              await fail(
                'Could not find CCR PR or Installations PR URLs in init PR comments. ' +
                'Run /config on this PR before running /create-mc.'
              );
              return;
            }

            const ccrParts = ccrURL.match(/github\.com\/([^/]+)\/([^/]+)\/pull\/(\d+)/);
            const instParts = instURL.match(/github\.com\/([^/]+)\/([^/]+)\/pull\/(\d+)/);
            if (!ccrParts || !instParts) {
              await fail(`Could not parse PR URLs: CCR=${ccrURL} installations=${instURL}`);
              return;
            }
            const [, ccrOrg, ccrRepo, ccrNum] = ccrParts;
            const [, instOrg, instRepo, instNum] = instParts;

            // Only the PRs mctl opens for this installation (the App token reaches every repo of the org).
            const ccrWant = context.repo.repo.replace(/-management-clusters$/, '') + '-configs';
            if (ccrOrg !== context.repo.owner || ccrRepo !== ccrWant ||
                instOrg !== context.repo.owner || instRepo !== 'installations') {
              await fail(
                `The reported PRs are not in ${context.repo.owner}/${ccrWant} and ` +
                `${context.repo.owner}/installations: CCR=${ccrURL} installations=${instURL}`
              );
              return;
            }

            let ccrPR;
            try {
              ({ data: ccrPR } = await github.rest.pulls.get({
                owner: ccrOrg, repo: ccrRepo, pull_number: parseInt(ccrNum),
              }));
            } catch (err) {
              await fail(`Could not read CCR PR ${ccrURL}: ${err.status || err.message}`);
              return;
            }
            const ccrHead = `${installation}-config`;
            if (ccrPR.head.ref !== ccrHead || ccrPR.head.repo?.full_name !== ccrPR.base.repo.full_name ||
                ccrPR.base.ref !== ccrPR.base.repo.default_branch) {
              await fail(`CCR PR ${ccrURL} is not from the \`${ccrHead}\` branch of ${ccrOrg}/${ccrRepo} into its default branch.`);
              return;
            }

            if (ccrPR.merged) {
              core.info('CCR PR already merged — continuing.');
            } else if (ccrPR.state === 'closed') {
              await fail(`CCR PR ${ccrURL} is closed without being merged, so the pipeline was not started.`);
              return;
            } else {
              core.info(`Merging CCR PR: ${ccrOrg}/${ccrRepo}#${ccrNum}`);
              try {
                await github.rest.pulls.merge({
                  owner: ccrOrg,
                  repo: ccrRepo,
                  pull_number: parseInt(ccrNum),
                  // Squash is the only method allowed on all CCR repos.
                  merge_method: 'squash',
                  // Merge exactly the commit checked above.
                  sha: ccrPR.head.sha,
                });
              } catch (err) {
                await fail(
                  `Could not merge CCR PR ${ccrURL} (it needs an approving review): ${err.message}. ` +
                  'Flux must read that config during the bootstrap, so the pipeline was not started.'
                );
                return;
              }
            }

            core.info(
              `Installations PR ${instOrg}/installations#${instNum} left open — ` +
              'zz_generated.mctl_merge_cascade.yaml merges it when this init PR is merged.'
            );

      # The Tekton pipeline replaces this comment in place via its result token.
      - name: Post running comment
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        env:
          INSTALLATION: ${{ steps.install.outputs.name }}
        with:
          script: |
            const installation = process.env.INSTALLATION;
            const token = `<!-- mctl-create-mc-result-${installation} -->`;
            await github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.issue.number,
              body: [
                token,
                `### ⚙️ Bootstrapping \`${installation}\``,
                '',
                'The CCR PR has been merged. The Tekton pipeline is starting.',
                '',
                'Track progress: [Tekton dashboard — mctl-create-mc runs]' +
                '(https://tekton.ci.giantswarm.io/#/namespaces/tekton-pipelines' +
                '/pipelineruns?labelSelector=tekton.dev%2Fpipeline%3Dmctl-create-mc)',
                '',
                'Results will be posted here when the pipeline completes.',
              ].join('\n'),
            });

      # Hidden comment matched by the Tekton CEL filter; carries MCTL_IMAGE so the pipeline runs the same mctl.
      - name: Post Tekton trigger comment
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        env:
          INSTALLATION: ${{ steps.install.outputs.name }}
        with:
          github-token: ${{ steps.app-token.outputs.token }}
          script: |
            const installation = process.env.INSTALLATION;
            const mctlImage = process.env.MCTL_IMAGE;
            await github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.issue.number,
              // Visible text so the comment isn't blank in the UI.
              body: `<!-- mctl-create-mc INSTALLATION=${installation} MCTL_IMAGE=${mctlImage} -->\n_Triggering Tekton bootstrap pipeline for \`${installation}\`…_`,
            });
