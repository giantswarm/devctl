{{{{ .Header }}}}

name: Add issue to general customer board

on:
  issues:
    types: [opened]

permissions: {}

jobs:
  add-to-board:
    uses: giantswarm/github-workflows/.github/workflows/issue-to-customer-board.yaml@main
    secrets:
      PROJECT_AUTOMATION_CLIENT_ID: ${{ secrets.PROJECT_AUTOMATION_CLIENT_ID }}
      PROJECT_AUTOMATION_PRIVATE_KEY: ${{ secrets.PROJECT_AUTOMATION_PRIVATE_KEY }}
