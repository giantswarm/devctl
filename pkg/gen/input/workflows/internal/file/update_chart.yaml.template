{{{{ .Header }}}}

name: Create Update Chart PR

on:
  push:
    branches:
      - 'main#update-chart'
      - 'master#update-chart'
  workflow_call:
    inputs:
      branch:
        required: true
        type: string

permissions: {}

jobs:
  update-chart:
    uses: giantswarm/github-workflows/.github/workflows/update-chart.yaml@main
    with:
      branch: ${{ inputs.branch }}
    secrets:
      RELEASE_BOT_CLIENT_ID: ${{ secrets.RELEASE_BOT_CLIENT_ID }}
      RELEASE_BOT_PRIVATE_KEY: ${{ secrets.RELEASE_BOT_PRIVATE_KEY }}
    permissions:
      contents: write
