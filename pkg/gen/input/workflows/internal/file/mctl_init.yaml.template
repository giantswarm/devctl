# Creating an {installation}-init-{provider} branch runs `mctl init --placeholders` and opens the init PR.

name: Init

on:
  create:

permissions:
  contents: read
  pull-requests: write
  issues: write

env:
  MCTL_IMAGE: ${{ vars.MCTL_IMAGE || 'gsoci.azurecr.io/giantswarm/mctl:{{{{ .MctlVersion }}}}' }}

jobs:
  init:
    name: Run mctl init
    runs-on: ubuntu-latest
    # Not in the template repo; only *-init-{provider} branch creation.
    if: >
      github.repository != 'giantswarm/template-management-clusters' &&
      github.event.ref_type == 'branch' &&
      (
        endsWith(github.event.ref, '-init-capa')   ||
        endsWith(github.event.ref, '-init-capz')   ||
        endsWith(github.event.ref, '-init-capv')   ||
        endsWith(github.event.ref, '-init-capvcd')
      )

    steps:
      - name: Parse branch name
        id: parse
        env:
          BRANCH: ${{ github.event.ref }}
        run: |
          # antiaws-init-capa → installation=antiaws, provider=capa
          if [[ "$BRANCH" =~ ^(.+)-init-(capa|capz|capv|capvcd)$ ]]; then
            echo "installation=${BASH_REMATCH[1]}" >> "$GITHUB_OUTPUT"
            echo "provider=${BASH_REMATCH[2]}"     >> "$GITHUB_OUTPUT"
          else
            echo "Could not parse branch: $BRANCH" >&2
            exit 1
          fi

      - name: Generate app token
        id: app-token
        uses: actions/create-github-app-token@v3
        with:
          app-id: ${{ secrets.MCTL_APP_ID }}
          private-key: ${{ secrets.MCTL_APP_PRIVATE_KEY }}
          # Owner-scoped so cross-repo calls work.
          owner: ${{ github.repository_owner }}

      - name: Run mctl init
        id: mctl
        env:
          INSTALLATION: ${{ steps.parse.outputs.installation }}
          PROVIDER:     ${{ steps.parse.outputs.provider }}
          BRANCH:       ${{ github.event.ref }}
          CMC_REPO:     ${{ github.event.repository.name }}
          ORG:          ${{ github.repository_owner }}
          GITHUB_TOKEN: ${{ steps.app-token.outputs.token }}
        run: |
          set +e

          # antonia-management-clusters → customer=antonia, ccr=antonia-configs
          CUSTOMER="${CMC_REPO%-management-clusters}"
          CCR_REPO="${CUSTOMER}-configs"

          # mctl owns the placeholder list.
          output=$(docker run --rm \
            -e GITHUB_TOKEN \
            "$MCTL_IMAGE" \
            init \
              --installation "$INSTALLATION" \
              --provider     "$PROVIDER" \
              --customer     "$CUSTOMER" \
              --cmc-repo     "$CMC_REPO" \
              --ccr-repo     "$CCR_REPO" \
              --branch       "$BRANCH" \
              --placeholders \
            2>&1)
          exit_code=$?
          {
            echo "output<<MCTL_EOF"
            echo "$output"
            echo "MCTL_EOF"
            echo "exit_code=$exit_code"
          } >> "$GITHUB_OUTPUT"

      - name: Post comment
        if: always()
        uses: actions/github-script@f28e40c7f34bde8b3046d885e986cb6290c5673b # v7.1.0
        env:
          MCTL_OUTPUT:    ${{ steps.mctl.outputs.output }}
          MCTL_EXIT_CODE: ${{ steps.mctl.outputs.exit_code }}
          BRANCH:         ${{ github.event.ref }}
          PROVIDER:       ${{ steps.parse.outputs.provider }}
        with:
          script: |
            const output   = process.env.MCTL_OUTPUT || '';
            const exitCode = parseInt(process.env.MCTL_EXIT_CODE || '1', 10);
            const branch   = process.env.BRANCH;
            const provider = process.env.PROVIDER;

            // Fail the job explicitly when mctl failed.
            if (exitCode !== 0) {
              const prs = await github.rest.pulls.list({
                owner: context.repo.owner,
                repo: context.repo.repo,
                head: `${context.repo.owner}:${branch}`,
                state: 'open',
              });
              if (prs.data.length > 0) {
                await github.rest.issues.createComment({
                  owner: context.repo.owner,
                  repo: context.repo.repo,
                  issue_number: prs.data[0].number,
                  body: `### ❌ \`mctl init\` failed\n\n\`\`\`\n${output}\n\`\`\``,
                });
              }
              core.setFailed(`mctl init exited ${exitCode}`);
              return;
            }

            const prs = await github.rest.pulls.list({
              owner: context.repo.owner,
              repo: context.repo.repo,
              head: `${context.repo.owner}:${branch}`,
              state: 'open',
            });
            if (prs.data.length === 0) return;
            const prNumber = prs.data[0].number;

            // mctl prints the /init command after this marker.
            const marker  = 'Fill them in by commenting:';
            const cmdLine = output.split('\n').find(l => l.startsWith(marker));
            if (!cmdLine) return;
            const initCmd = cmdLine.slice(marker.length).trim();

            // CAPA: /config fails until the aws-account-setup PR has applied.
            const nextStep = provider === 'capa'
              ? 'Replace each `<PLACEHOLDER>` with the real value. `/init` then opens an aws-account-setup PR: approve it (auto-merges) and, once the validation check is green, comment `/config` to continue.'
              : 'Replace each `<PLACEHOLDER>` with the real value. Once the validation check is green, comment `/config` to continue.';

            const body = [
              '### Placeholder values need to be filled in',
              '',
              'This PR was generated with placeholder values. Fill them in by commenting:',
              '',
              '```',
              initCmd,
              '```',
              '',
              nextStep,
            ].join('\n');

            await github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: prNumber,
              body,
            });
