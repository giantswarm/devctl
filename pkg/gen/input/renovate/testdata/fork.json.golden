// DO NOT EDIT. This file is generated by `devctl gen renovate --flavour fork`.
// Repo-specific Renovate rules belong in renovate-custom.json5 (repo root) --
// it is added as the last `extends` entry when present and never touched by
// devctl. Rules for a whole class of repos belong in
// giantswarm/renovate-presets instead.
//
// This repository is a GitHub fork. Renovate skips a fork unless its default
// config file, renovate.json (never renovate.json5), sets forkProcessing to
// "enabled" itself, which no preset can do for it: hence this file's name and
// that key.
{
  "forkProcessing": "enabled",
  "extends": [
    // Base config - https://github.com/giantswarm/renovate-presets/blob/main/default.json5
    "github>giantswarm/renovate-presets:default.json5",
    // Go specific config - https://github.com/giantswarm/renovate-presets/blob/main/lang-go.json5
    "github>giantswarm/renovate-presets:lang-go.json5",
    // Repo-owned overrides -- last entry, so its rules win over the presets.
    // Renovate resolves this from the default branch on every run: edits are
    // live on merge, no regeneration needed.
    "github>giantswarm/kagent-upstream:renovate-custom.json5"
  ],
  // Our own bots commit onto Renovate branches. The giantswarm-release
  // GitHub App pushes what the generated workflows produce
  // (zz_generated.helm-docs-regen.yaml, the update-chart and
  // sync-from-upstream flows); taylorbot <dev@giantswarm.io> did so before
  // it and still does in repositories whose workflows are not regenerated
  // yet. giantswarm-marge[bot] writes the bot PR's
  // changelog entry during the sweep, in the repositories that still cut a
  // release from CHANGELOG.md. Renovate treats a branch whose last commit is
  // by anyone else as edited by a human: it stops rebasing it and, on
  // autoclose, retitles the PR "- abandoned" instead of closing it. Listing
  // the authors here makes those commits Renovate's own. Renovate compares
  // the author email, so these are the bare addresses.
  "gitIgnoredAuthors": [
    "342014845+giantswarm-release[bot]@users.noreply.github.com",
    "dev@giantswarm.io",
    "329428426+giantswarm-marge[bot]@users.noreply.github.com"
  ],
  "reviewers": [
    "teemow"
  ],
  // Assign the configured reviewers even to PRs Renovate auto-merges, so they
  // are still requested for review. Without this Renovate skips review
  // requests on auto-merged PRs.
  "assignAutomerge": true
}
