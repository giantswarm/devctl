# DO NOT EDIT. This file is generated by `devctl gen circleci` and kept in sync
# by the giantswarm/github align-files workflow. Change the generator in devctl
# (pkg/gen/input/circleci) or the gen.ci config in giantswarm/github, not here.
#
# The per-image pipeline of a multi-image repository. __IMAGE__ stands for an
# image's name, its directory under {{ .ImagesDir }}/: the setup workflow in
# .circleci/config.yml continues the pipeline with one copy of a workflow
# below per image to build, __IMAGE__ replaced, and merges the optional
# repo-owned .circleci/custom.yml in. Every image builds with {{ .ImagesDir }}/ as its
# context, so it can use the build files the images share there.
#
# The repository's own check of an image, run before its release is
# published, is the job check-image in .circleci/custom.yml, with a string
# parameter `image` (the image's name). Without it the release publishes
# straight away.
version: 2.1
orbs:
  architect: giantswarm/architect@{{ .OrbVersion }}

workflows:
  # Branch build: an amd64 dev image of a changed image, for a proof before
  # merge. It never moves `latest`.
  build-__IMAGE__:
    jobs:
    - architect/push-to-registries:
        context: architect
        name: push-__IMAGE__
        image: {{ .ImageNamePrefix }}/__IMAGE__
        dockerfile: ./{{ .ImagesDir }}/__IMAGE__/Dockerfile
        build-context: ./{{ .ImagesDir }}
        platforms: "linux/amd64"
        resource_class: medium
        persist-build-version: false
{{- if .ForcePublic }}
        # Private repo that publishes public images: architect otherwise
        # derives private from the repo visibility, so force the public push.
        force-public: true
{{- end }}
        registries-data: |-
          {{ .Registry }}
        filters:
          branches:
            ignore:
            - {{ .DefaultBranch }}

  # Tag build of <image>/vX.Y.Z: the repository's check, then the multi-arch
  # image under its version and `latest`. The push requires the check, so
  # nothing is published that does not pass it.
  release-__IMAGE__:
    jobs:
    - check-image:
        name: check-image-__IMAGE__
        image: __IMAGE__
        filters:
          tags:
            only: /^__IMAGE__\/v.*/
          branches:
            ignore: /.*/
    - architect/push-to-registries:
        context: architect
        name: push-__IMAGE__
        image: {{ .ImageNamePrefix }}/__IMAGE__
        dockerfile: ./{{ .ImagesDir }}/__IMAGE__/Dockerfile
        build-context: ./{{ .ImagesDir }}
        platforms: "{{ .ImagePlatforms }}"
        resource_class: medium
        git-tag-prefix: __IMAGE__
{{- if .ForcePublic }}
        force-public: true
{{- end }}
        registries-data: |-
          {{ .Registry }}
        requires:
        - check-image-__IMAGE__
        filters:
          tags:
            only: /^__IMAGE__\/v.*/
          branches:
            ignore: /.*/
